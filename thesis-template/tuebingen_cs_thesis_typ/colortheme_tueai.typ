// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// % Color scheme of the Eberhard-Karls University %
// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

// According to the Corporate Design, all of these colors may
// lightened in steps of 10% e.g. via TUred!30!white

// Primary Colors
#let TUred = rgb(165, 30, 55)
#let TUgold = rgb(180, 160, 105)
#let TUdark = rgb(50, 65, 75) // #32414b
#let TUgray = rgb(175, 179, 183)

// Secondary Colors
#let TUdarkblue = rgb(65, 90, 140)
#let TUblue = rgb(0, 105, 170)
#let TUlightblue = rgb(80, 170, 200)
#let TUlightgreen = rgb(130, 185, 160)
#let TUgreen = rgb(125, 165, 75)
#let TUdarkgreen = rgb(50, 110, 30)
#let TUocre = rgb(200, 80, 60)
#let TUviolet = rgb(175, 110, 150)
#let TUmauve = rgb(180, 160, 150)
#let TUbeige = rgb(215, 180, 105)
#let TUorange = rgb(210, 150, 0)
#let TUbrown = rgb(145, 105, 70)

// scheme of the AI center
// b/w
#let TueAIdark = rgb(56, 56, 56)
#let TueAIgray = rgb(246, 246, 246)
// primary colors
#let TueAIdarkblue = rgb(26, 58, 91)
#let TueAIaccent = rgb(234, 75, 46)
#let TueAIlightblue = rgb(133, 203, 210)
// secondary colors
#let TueAIoceanblue = rgb(119, 221, 204)
#let TueAIoceangreen = rgb(119, 221, 159)
#let TueAIspringgreen = rgb(186, 213, 72)
#let TueAIbrightyellow = rgb(255, 221, 0)

// Bibliography color aliases
#let citeauthorcolor = TueAIdarkblue
#let citetitlecolor = TueAIaccent
#let citevenuecolor = TueAIdark
